# AminAmval (امین اموال ناواکو) — systemd service (Linux servers)
# نصب:
#   1) sudo apt-get update && sudo apt-get install -y nodejs npm   (Node ≥ 22.5)
#   2) بسته را (کل ریپو) در /opt/AminAmval قرار دهید:
#        sudo mkdir -p /opt/AminAmval && sudo cp -r . /opt/AminAmval
#   3) cd /opt/AminAmval/deploy && sudo npm install --omit=dev
#   4) فایل env را بسازید (رمزها را عوض کنید):
#        sudo cp env.example /etc/aminamval.env && sudo chmod 600 /etc/aminamval.env
#   5) sudo cp aminamval.service /etc/systemd/system/
#   6) sudo systemctl daemon-reload
#   7) sudo systemctl enable --now aminamval
# وضعیت:  sudo systemctl status aminamval
# لاگ‌ها: sudo journalctl -u aminamval -f
[Unit]
Description=AminAmval (امین اموال ناواکو) asset management
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/AminAmval/deploy
EnvironmentFile=/etc/aminamval.env
Environment=HOST=0.0.0.0
Environment=PORT=8080
ExecStart=/usr/bin/node server.js
Restart=always                       # همیشه بالا بماند
RestartSec=5
# امنیت دفاعی
User=aminamval
Group=aminamval
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/AminAmval/src/AminAmval.Api/runtime-data
# چرخش لاگ
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
