# AminAmval — environment variables for systemd (copy to /etc/aminamval.env)
# «باید» مقادیر را عوض کنید و دسترسی را محدود کنید: chmod 600

# گذرواژه‌های اولیهٔ اجباری (فقط برای bootstrap اولین اجرا؛ بعداً کاربران عوض می‌کنند)
ADMIN_PASSWORD=Admin1289@@@
CUSTODIAN_PASSWORD=Jamdar1289@@@

# حالت پراکسی HTTPS (پشت Nginx/Traefik/Caddy): کوکی Secure + SameSite=None
PREVIEW_MODE=true

# پورت داخلی (پروکسی به بیرون 443 می‌دهد)
PORT=8080

# زمان پشتیبان‌گیری خودکار روزانه (UTC)
BACKUP_HOUR_UTC=22
BACKUP_MINUTE_UTC=30
BACKUP_RETENTION_DAYS=14
