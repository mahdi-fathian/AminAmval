using System.Security.Claims;using System.Security.Cryptography;using System.Text.Json;using System.Text.RegularExpressions;using AminAmval.Data;using AminAmval.Domain.Enums;using AminAmval.Models;using Microsoft.AspNetCore.Identity;using Microsoft.EntityFrameworkCore;namespace AminAmval.Services;public class ApiException(int status, string message, object? errors = null) : Exception(message){    public int Status { get; } = status;    public object? Errors { get; } = errors;}public class Storage{    public string Root { get; }    public string Database => Path.Combine(Root, "amin.db");    public string Uploads => Path.Combine(Root, "uploads");    public string Backups => Path.Combine(Root, "backups");    public string Keys => Path.Combine(Root, "keys");    public Storage(IConfiguration config, IWebHostEnvironment env)    {        Root = Path.GetFullPath(config["DATA_DIR"] ?? Path.Combine(env.ContentRootPath, "runtime-data"));        foreach (var p in new[] { Root, Uploads, Backups, Keys })        {            Directory.CreateDirectory(p);            if (!OperatingSystem.IsWindows()) File.SetUnixFileMode(p, UnixFileMode.UserRead | UnixFileMode.UserWrite | UnixFileMode.UserExecute);        }    }}public static class Core{    public static string UserId(this HttpContext c) => c.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";    public static bool IsAdmin(this HttpContext c) => c.User.IsInRole(Roles.Admin);    public static bool IsStaff(this HttpContext c) => c.IsAdmin() || c.User.IsInRole(Roles.Custodian);    public static string Clean(string? value, int max = 200) => (value ?? "").Trim().Replace('ÙŠ', 'ÛŒ').Replace('Ùƒ', 'Ú©') is var s && s.Length <= max ? s : throw new ApiException(400, $"Ø·ÙˆÙ„ Ù…ØªÙ† Ù†Ø¨Ø§ÛŒØ¯ Ø¨ÛŒØ´ØªØ± Ø§Ø² {max} Ù†ÙˆÛŒØ³Ù‡ Ø¨Ø§Ø´Ø¯.");    public static string Digits(string? value) => Clean(value).Select(c => "Û°Û±Û²Û³Û´ÛµÛ¶Û·Û¸Û¹".IndexOf(c) is var n && n >= 0 ? (char)('0' + n) : "Ù Ù¡Ù¢Ù£Ù¤Ù¥Ù¦Ù§Ù¨Ù©".IndexOf(c) is var m && m >= 0 ? (char)('0' + m) : c).Aggregate("", (s, c) => s + c);    public static string Required(string? value, string label, int max = 200) { var s = Clean(value, max); if (s.Length == 0) throw new ApiException(400, $"{label} Ø§Ù„Ø²Ø§Ù…ÛŒ Ø§Ø³Øª."); return s; }    public static void CheckVersion(int current, int expected) { if (current != expected) throw new ApiException(409, "Ø§Ø·Ù„Ø§Ø¹Ø§Øª ØªÙˆØ³Ø· Ú©Ø§Ø±Ø¨Ø± Ø¯ÛŒÚ¯Ø±ÛŒ ØªØºÛŒÛŒØ± Ú©Ø±Ø¯Ù‡ Ø§Ø³Øª. ØµÙØ­Ù‡ Ø±Ø§ ØªØ§Ø²Ù‡â€ŒØ³Ø§Ø²ÛŒ Ùˆ Ø¯ÙˆØ¨Ø§Ø±Ù‡ ØªÙ„Ø§Ø´ Ú©Ù†ÛŒØ¯."); }    public static bool ValidNationalId(string s)    {        if (!Regex.IsMatch(s, "^[0-9]{10}$") || s.Distinct().Count() == 1) return false;        var sum = s.Take(9).Select((c, i) => (c - '0') * (10 - i)).Sum() % 11;        return s[9] - '0' == (sum < 2 ? sum : 11 - sum);    }    public static string Username(string? s)    {        var v = Digits(s).ToLowerInvariant();        if (!Regex.IsMatch(v, "^[a-z0-9][a-z0-9._-]{2,59}$")) throw new ApiException(400, "Ù†Ø§Ù… Ú©Ø§Ø±Ø¨Ø±ÛŒ Ø¨Ø§ÛŒØ¯ Û³ ØªØ§ Û¶Û° Ø­Ø±Ù Ù„Ø§ØªÛŒÙ†ØŒ Ø¹Ø¯Ø¯ØŒ Ù†Ù‚Ø·Ù‡ØŒ Ø®Ø· ØªÛŒØ±Ù‡ ÛŒØ§ Ø²ÛŒØ±Ø®Ø· Ø¨Ø§Ø´Ø¯.");        return v;    }    public static void StrongPassword(string? s)    {        if (s is null || s.Length < 12 || s.Length > 128 || !s.Any(char.IsLower) || !s.Any(char.IsUpper) || !s.Any(char.IsDigit) || !s.Any(c => !char.IsLetterOrDigit(c))) throw new ApiException(400, "Ú¯Ø°Ø±ÙˆØ§Ú˜Ù‡ Ø¨Ø§ÛŒØ¯ Û±Û² ØªØ§ Û±Û²Û¸ Ù†ÙˆÛŒØ³Ù‡ Ùˆ Ø´Ø§Ù…Ù„ Ø­Ø±ÙˆÙ Ø¨Ø²Ø±Ú¯ Ùˆ Ú©ÙˆÚ†Ú© Ù„Ø§ØªÛŒÙ†ØŒ Ø¹Ø¯Ø¯ Ùˆ Ù†Ù…Ø§Ø¯ Ø¨Ø§Ø´Ø¯.");        if (!Regex.IsMatch(s, "[a-z]") || !Regex.IsMatch(s, "[A-Z]")) throw new ApiException(400, "Ø¯Ø± Ú¯Ø°Ø±ÙˆØ§Ú˜Ù‡ Ø§Ø² Ø­Ø±ÙˆÙ Ø¨Ø²Ø±Ú¯ Ùˆ Ú©ÙˆÚ†Ú© Ù„Ø§ØªÛŒÙ† Ø§Ø³ØªÙØ§Ø¯Ù‡ Ú©Ù†ÛŒØ¯.");    }    public static DateTime ValidDate(DateTime d, string label)    {        d = DateTime.SpecifyKind(d, DateTimeKind.Utc);        if (d.Year < 1900 || d.Date > DateTime.UtcNow.AddHours(3.5).Date) throw new ApiException(400, $"{label} Ù…Ø¹ØªØ¨Ø± Ù†ÛŒØ³Øª ÛŒØ§ Ø¯Ø± Ø¢ÛŒÙ†Ø¯Ù‡ Ø§Ø³Øª.");        return d;    }    public static void CheckChronology(Asset asset, DateTime date)    {        if (asset.LastOperationDate.HasValue && date < asset.LastOperationDate.Value) throw new ApiException(400, "ØªØ§Ø±ÛŒØ® Ø¹Ù…Ù„ÛŒØ§Øª Ù†Ù…ÛŒâ€ŒØªÙˆØ§Ù†Ø¯ Ù‚Ø¨Ù„ Ø§Ø² Ø¢Ø®Ø±ÛŒÙ† Ø±ÙˆÛŒØ¯Ø§Ø¯ Ø§Ù…ÙˆØ§Ù„ Ø¨Ø§Ø´Ø¯.");        if (asset.PurchaseDate.HasValue && date.Date < asset.PurchaseDate.Value.Date) throw new ApiException(400, "ØªØ§Ø±ÛŒØ® Ø¹Ù…Ù„ÛŒØ§Øª Ù†Ù…ÛŒâ€ŒØªÙˆØ§Ù†Ø¯ Ù‚Ø¨Ù„ Ø§Ø² ØªØ§Ø±ÛŒØ® Ø®Ø±ÛŒØ¯ Ø¨Ø§Ø´Ø¯.");        var latestEnd = asset.Assignments.Where(x => x.EndedAt != null).Max(x => x.EndedAt);        if (latestEnd.HasValue && date < latestEnd.Value) throw new ApiException(400, "ØªØ§Ø±ÛŒØ® Ø¹Ù…Ù„ÛŒØ§Øª Ù†Ù…ÛŒâ€ŒØªÙˆØ§Ù†Ø¯ Ù‚Ø¨Ù„ Ø§Ø² Ø¢Ø®Ø±ÛŒÙ† Ø¹ÙˆØ¯Øª ÛŒØ§ Ø§Ù†ØªÙ‚Ø§Ù„ Ø¨Ø§Ø´Ø¯.");    }    public static object PublicUser(AppUser u) => new { u.Id, u.Username, u.PersonnelCode, u.FirstName, u.LastName, fullName = u.FirstName + " " + u.LastName, u.NationalId, u.DepartmentId, departmentName = u.Department?.Name, u.Role, u.Active, u.MustChangePassword, u.Version, u.CreatedAt };    public static object AuditUser(AppUser u) => new { u.Id, u.Username, u.PersonnelCode, u.FirstName, u.LastName, nationalId = u.NationalId == null ? null : "******" + u.NationalId[^4..], u.DepartmentId, u.Role, u.Active, u.Version };    public static object AssetSnapshot(Asset a) => new { a.Id, a.Code, a.OldCode, a.Name, a.CategoryId, a.Brand, a.Model, a.Serial, a.Quality, a.Owner, a.Description, a.ImageId, a.PurchaseDate, a.PurchaseCost, a.HasLabel, a.Status, a.Location, a.Deleted, a.Version };    public static object AssetView(Asset a, bool staff = true)    {        var current = a.Assignments.FirstOrDefault(x => x.EndedAt == null);        return new { a.Id, a.Code, a.OldCode, a.Name, a.CategoryId, categoryName = a.Category?.Name, a.Brand, a.Model, a.Serial, a.Quality, a.Owner, a.Description, a.ImageId, a.PurchaseDate, purchaseCost = staff ? a.PurchaseCost : null, a.HasLabel, a.Status, a.Location, a.Deleted, pendingRequestId = a.DispositionRequests.FirstOrDefault(x => x.State == "Pending")?.Id, a.Version, a.CreatedAt, a.UpdatedAt, currentAssignment = current == null ? null : AssignmentView(current) };    }    public static object AssignmentView(Assignment x) => new { x.Id, x.AssetId, x.UserId, x.DepartmentId, userName = x.UserId == null ? null : x.RecipientName, departmentName = x.DepartmentName, x.StartedAt, x.EndedAt, x.Notes, x.Reference, x.EndReason };    public static void Log(this AppDb db, HttpContext? c, string action, string type, string? id, string description, object? before = null, object? after = null, string? assetId = null, string? targetUser = null)    {        var options = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };        db.Audit.Add(new AuditEvent { ActorId = string.IsNullOrEmpty(c?.UserId()) ? null : c.UserId(), ActorName = c?.User.Identity?.Name ?? "Ø³Ø§Ù…Ø§Ù†Ù‡", ActorRole = c?.User.FindFirstValue(ClaimTypes.Role) ?? "System", Ip = c?.Connection.RemoteIpAddress?.ToString() ?? "system", Action = action, EntityType = type, EntityId = id, Description = description, Before = before == null ? null : JsonSerializer.Serialize(before, options), After = after == null ? null : JsonSerializer.Serialize(after, options), AssetId = assetId ?? (type == "Asset" ? id : null), TargetUserId = targetUser ?? (type == "User" ? id : null), CorrelationId = c?.TraceIdentifier ?? Guid.NewGuid().ToString("N") });    }    public static ClaimsPrincipal Principal(AppUser u, string sessionId) => new(new ClaimsIdentity(new[] { new Claim(ClaimTypes.NameIdentifier, u.Id), new Claim(ClaimTypes.Name, u.FirstName + " " + u.LastName), new Claim(ClaimTypes.Role, u.Role), new Claim("sid", sessionId), new Claim("stamp", u.SecurityStamp), new Claim("change", u.MustChangePassword ? "1" : "0") }, "Cookies"));    public static string NewPassword() => "Nv!" + Convert.ToHexString(RandomNumberGenerator.GetBytes(8)).ToLowerInvariant() + "A7";    public static async Task ResetAsync(AppDb db)    {        await db.Images.ExecuteDeleteAsync();        await db.Sessions.ExecuteDeleteAsync();        await db.AuditEvents.Where(a => a.EntityType != "System").ExecuteDeleteAsync();        await db.DispositionRequests.ExecuteDeleteAsync();        await db.Assignments.ExecuteDeleteAsync();        await db.Assets.Where(a => !a.Deleted).ExecuteDeleteAsync();        await db.Assets.Where(a => a.Deleted).ExecuteDeleteAsync();        await db.Users.Where(u => u.Role != UserRole.Admin && u.Role != UserRole.Custodian).ExecuteDeleteAsync();    }    public static async Task BootstrapAsync(IServiceProvider services)    {        using var scope = services.CreateScope();        var db = scope.ServiceProvider.GetRequiredService<AppDb>();        var storage = scope.ServiceProvider.GetRequiredService<Storage>();        var cfg = scope.ServiceProvider.GetRequiredService<IConfiguration>();        await db.Database.EnsureCreatedAsync();        if (await db.Users.AnyAsync()) return;        var lines = new List<string> { "AminAmval - Initial Credentials", "Delete this file after secure delivery.", "" };        foreach (var (username, role, first, last, key) in new[] { ("admin", Roles.Admin, "Admin", "System", "ADMIN_PASSWORD"), ("jamdar", Roles.Custodian, "Custodian", "Assets", "CUSTODIAN_PASSWORD") })        {            var password = string.IsNullOrWhiteSpace(cfg[key]) ? NewPassword() : cfg[key]!; StrongPassword(password);            var user = new AppUser { Username = username, PersonnelCode = "SYS-" + username.ToUpperInvariant(), FirstName = first, LastName = last, Role = role };            user.PasswordHash = new PasswordHasher<AppUser>().HashPassword(user, password);            db.Users.Add(user);            lines.Add($"{role}: {username} / {password}");        }        db.Log(null, "bootstrap", "System", null, "Initial system bootstrap with two admin accounts.");        await db.SaveChangesAsync();        await SeedSampleDataAsync(db);        var file = Path.Combine(storage.Root, "initial-credentials.txt");        await File.WriteAllLinesAsync(file, lines);        if (!OperatingSystem.IsWindows()) File.SetUnixFileMode(file, UnixFileMode.UserRead | UnixFileMode.UserWrite);    }    private static async Task SeedSampleDataAsync(AppDb db)    {        var departments = new[] { "IT", "HR", "FIN", "LOG", "SEC", "PR" };        var deptList = departments.Select(d => { var dept = new Department { Name = d }; db.Departments.Add(dept); return dept; }).ToList();        await db.SaveChangesAsync();        var cats = new (string Name, string Desc)[] { ("Computers", "Laptops, Desktops, Monitors, Printers"), ("Communication", "Phones, Fax, Switches, Routers"), ("AV Equipment", "Projectors, Cameras, Microphones"), ("Furniture", "Desks, Chairs, Cabinets, Shelves"), ("Vehicles", "Cars, Motorcycles, Bicycles"), ("Tools", "Drills, Screwdrivers, Wrenches") };        var categories = cats.Select(c => { var cat = new Category { Name = c.Name, Description = c.Desc }; db.Categories.Add(cat); return cat; }).ToList();        await db.SaveChangesAsync();        var employees = new[] { ("E1001", "Ahmad", "Mohammadi", "0012345678", 0, 0), ("E1002", "Maryam", "Ahmadi", "0012345679", 0, 0), ("E1003", "Ali", "Rezaei", "0012345680", 0, 1), ("E1004", "Fatemeh", "Karimi", "0012345681", 0, 2), ("E1005", "Mohammad", "Hosseini", "0012345682", 0, 3), ("E1006", "Zahra", "Mousavi", "0012345683", 0, 4), ("E1007", "Reza", "Jafari", "0012345684", 0, 5), ("E1008", "Sara", "Sadeghi", "0012345685", 0, 0) };        var users = employees.Select(e => { var dept = deptList[e.Item6]; var user = new AppUser { PersonnelCode = e.Item1, Username = e.Item1.ToLower(), FirstName = e.Item2, LastName = e.Item3, NationalId = e.Item4, DepartmentId = dept.Id, Role = Roles.Employee, Active = true, MustChangePassword = true, PasswordHash = new PasswordHasher<AppUser>().HashPassword(null!, "Nv!Test123456A7") }; db.Users.Add(user); return user; }).ToList();        await db.SaveChangesAsync();        var brands = new[] { "Lenovo", "Dell", "HP", "Asus", "Acer", "Apple", "Samsung", "Sony" };        var models = new[] { "ThinkPad T14", "Latitude 5520", "EliteBook 840", "VivoBook S15", "Aspire 5", "MacBook Pro", "Galaxy Book", "VAIO" };        var qualities = new[] { "New", "Good", "Used", "Damaged" };        var locations = new[] { "Main Warehouse - Floor 1", "Main Warehouse - Floor 2", "Office 101", "Office 205", "Meeting Room 3", "IT Lab" };        var rnd = new Random(1402);        for (int i = 1; i <= 25; i++)        {            var cat = categories[rnd.Next(categories.Count)];            var brand = brands[rnd.Next(brands.Length)];            var model = models[rnd.Next(models.Length)];            var quality = qualities[rnd.Next(qualities.Length)];            var location = locations[rnd.Next(locations.Length)];            var hasLabel = rnd.Next(100) < 85;            var daysAgo = rnd.Next(1, 730);            var purchaseDate = DateTime.UtcNow.AddDays(-daysAgo);            var purchaseCost = (long)(rnd.Next(5, 200) * 10000000);            var asset = new Asset { Code = $"AST-2024-{i:D4}", Name = $"{brand} {model}", CategoryId = cat.Id, Brand = brand, Model = model, Serial = $"SN{DateTime.UtcNow.Year}{i:D6}", Quality = quality, Owner = "Navaco", HasLabel = hasLabel, PurchaseDate = purchaseDate, PurchaseCost = purchaseCost, Location = location, Status = States.Available, Description = $"Sample asset #{i}" };            db.Assets.Add(asset);        }        await db.SaveChangesAsync();        var assets = db.Assets.Take(10).ToList();        foreach (var asset in assets)        {            var user = users[rnd.Next(users.Count)];            var dept = deptList.First(d => d.Id == user.DepartmentId);            var assignment = new Assignment { AssetId = asset.Id, AssetCodeAtIssue = asset.Code, AssetNameAtIssue = asset.Name, SerialAtIssue = asset.Serial, QualityAtIssue = asset.Quality, IssuerName = "Custodian", UserId = user.Id, DepartmentId = dept.Id, RecipientName = user.FirstName + " " + user.LastName, DepartmentName = dept.Name, StartedAt = DateTime.UtcNow.AddDays(-rnd.Next(1, 90)), Reference = $"REF-{DateTime.UtcNow.Year}-{rnd.Next(1000, 9999)}", Notes = "Sample assignment", CreatedBy = "jamdar" };            db.Assignments.Add(assignment);            asset.Status = States.Assigned;        }        await db.SaveChangesAsync();    }    public static object FilterSnapshot(IQueryCollection query) => query.ToDictionary(x => x.Key, x => x.Key == "q" ? Regex.Replace(Digits(x.Value.ToString()), @"(?<!\d)\d{10}(?!\d)", "[Ú©Ø¯ Ø­Ø³Ø§Ø³ Ù…Ø§Ø³Ú©â€ŒØ´Ø¯Ù‡]") : x.Value.ToString());    public static (int Page, int Size) Paging(IQueryCollection q) => (int.TryParse(q["page"], out var p) ? Math.Clamp(p, 1, 100000) : 1, int.TryParse(q["pageSize"], out var s) ? Math.Clamp(s, 1, 100) : 20);}